#!/usr/bin/env bash
# fork-upstream — 检查本地维护的 fork 仓库上游是否有新提交
#
# 用法:
#   fork-upstream                    # 拉取并检查默认目录下的仓库（只读）
#   fork-upstream --fix              # 给缺 upstream 远端的 fork 用 gh 自动补上
#   fork-upstream --no-fetch         # 不联网拉取，只用已有远端引用判断
#   fork-upstream -r ~/some/dir      # 临时替换检查目录（可多次）
#   fork-upstream --json             # 输出机器可读结果（单个仓库为对象，多个为数组）
#   fork-upstream --timeout 5        # git fetch 超时秒数（默认 10）
#
# 要改检查目录，直接改下面的 BUILTIN_ROOTS。
#
# 判断逻辑:
#   * 有 upstream 远端 → 对比 upstream/<当前分支>
#   * 没有 upstream:
#       - gh 显示是 fork → 提示 --fix（--fix 时自动加远端再对比）
#       - 不是 fork（自己的仓库）→ 对比 origin/<当前分支>（一般恒为已同步）
set -uo pipefail

PROG=$(basename "$0")
FIX=0
FETCH=1
JSON=0
FETCH_TIMEOUT=10
CLI_ROOTS=()

BUILTIN_ROOTS=(
	"$HOME/neovim-plugins"
)

usage() {
	sed -n '2,10p' "$0"
}

while [ $# -gt 0 ]; do
	case "$1" in
	--fix) FIX=1 ;;
	--no-fetch) FETCH=0 ;;
	--json) JSON=1 ;;
	--timeout)
		[ $# -ge 2 ] || {
			echo "--timeout 需要一个秒数" >&2
			exit 2
		}
		case "$2" in
		'' | *[!0-9]*)
			echo "--timeout 需要正整数" >&2
			exit 2
			;;
		esac
		FETCH_TIMEOUT="$2"
		shift
		;;
	-r | --root)
		[ $# -ge 2 ] || {
			echo "-r/--root 需要一个目录参数" >&2
			exit 2
		}
		CLI_ROOTS+=("$2")
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "未知参数: $1" >&2
		exit 2
		;;
	*) CLI_ROOTS+=("$1") ;;
	esac
	shift
done

expand_dir() {
	local d="${1%/}"
	[ "$d" = "~" ] && d="$HOME"
	case "$d" in "~/"*) d="$HOME/${d#\~/}" ;; esac
	printf '%s' "$d"
}

# 目录：CLI 指定则替换，否则用内置默认
ROOTS=()
if [ ${#CLI_ROOTS[@]} -gt 0 ]; then
	for d in "${CLI_ROOTS[@]}"; do ROOTS+=("$(expand_dir "$d")"); done
else
	ROOTS=("${BUILTIN_ROOTS[@]}")
fi

missing=()
for d in "${ROOTS[@]}"; do [ -d "$d" ] || missing+=("$d"); done
if [ ${#missing[@]} -gt 0 ]; then
	printf '目录不存在: %s\n' "${missing[@]}" >&2
	[ ${#missing[@]} -eq ${#ROOTS[@]} ] && exit 1
fi

if [ -t 1 ]; then
	BOLD=$'\033[1m'
	DIM=$'\033[2m'
	RED=$'\033[31m'
	GREEN=$'\033[32m'
	YELLOW=$'\033[33m'
	RESET=$'\033[0m'
else
	BOLD="" DIM="" RED="" GREEN="" YELLOW="" RESET=""
fi

behind_repos=0
behind_total=0
dirty_count=0
need_fix=()
RESULTS=()
RESULT_COUNT=0

WIDTH=30

# git@github.com:owner/repo.git / https://github.com/owner/repo.git → owner/repo
repo_slug() {
	local url="${1%.git}"
	url="${url#git@github.com:}"
	url="${url#ssh://git@github.com/}"
	url="${url#https://github.com/}"
	printf '%s' "$url"
}

# 用 gh 查 fork 的父仓库，输出 ssh url；不是 fork 或失败则返回 1
parent_url_from_gh() {
	command -v gh >/dev/null 2>&1 || return 1
	local parent
	parent=$(gh repo view "$1" --json parent \
		--jq 'if .parent then .parent.owner.login + "/" + .parent.name else "" end' 2>/dev/null) || return 1
	[ -n "$parent" ] || return 1
	printf 'git@github.com:%s.git' "$parent"
}

is_git_repo() {
	git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

# 带超时的 fetch（macOS 没有 timeout(1)）
fetch_remote() {
	local dir="$1" remote="$2" pid ticks=0 max=$((FETCH_TIMEOUT * 5))
	GIT_TERMINAL_PROMPT=0 git -C "$dir" fetch --quiet --prune "$remote" >/dev/null 2>&1 &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$ticks" -ge "$max" ]; then
			kill "$pid" 2>/dev/null
			wait "$pid" 2>/dev/null
			return 1
		fi
		sleep 0.2
		ticks=$((ticks + 1))
	done
	wait "$pid" 2>/dev/null
}

json_escape() {
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	s="${s//$'\n'/\\n}"
	s="${s//$'\r'/\\r}"
	s="${s//$'\t'/\\t}"
	printf '%s' "$s"
}

# ============ 结果字段（check_repo 填充，emit_* 消费） ============
R_PATH="" R_NAME="" R_LABEL=""
R_BRANCH="" R_REMOTE="" R_AHEAD=0 R_BEHIND=0
R_DIRTY=false R_HAS_UPSTREAM=false R_IS_FORK=null R_UPSTREAM_URL=""
R_LAST_DATE="" R_LAST_SUBJECT="" R_STAT="" R_ERROR=""
R_COMMITS=""

emit_json() {
	local commits="" c err="null"
	if [ -n "$R_COMMITS" ]; then
		while IFS= read -r c; do
			commits="$commits${commits:+,}\"$(json_escape "$c")\""
		done <<< "$R_COMMITS"
	fi
	[ -n "$R_ERROR" ] && err="\"$(json_escape "$R_ERROR")\""
	RESULTS+=("$(printf '{"path":"%s","name":"%s","label":"%s","branch":"%s","remote":"%s","ahead":%d,"behind":%d,"dirty":%s,"has_upstream":%s,"is_fork":%s,"upstream_url":"%s","last":{"date":"%s","subject":"%s"},"commits":[%s],"error":%s}' \
		"$(json_escape "$R_PATH")" "$(json_escape "$R_NAME")" "$(json_escape "$R_LABEL")" \
		"$(json_escape "$R_BRANCH")" "$(json_escape "$R_REMOTE")" \
		"$R_AHEAD" "$R_BEHIND" "$R_DIRTY" "$R_HAS_UPSTREAM" "$R_IS_FORK" \
		"$(json_escape "$R_UPSTREAM_URL")" \
		"$(json_escape "$R_LAST_DATE")" "$(json_escape "$R_LAST_SUBJECT")" \
		"$commits" "$err")")
	RESULT_COUNT=$((RESULT_COUNT + 1))
}

emit_human() {
	local note=""
	[ "$R_DIRTY" = true ] && note="$note ${DIM}(有未提交改动)${RESET}"
	[ "$R_IS_FORK" = true ] && [ "$R_HAS_UPSTREAM" = false ] && note="$note ${DIM}(尚未配置 upstream)${RESET}"

	case "$R_ERROR" in
	not-a-repository | no-origin) return ;;
	fork-without-upstream)
		printf "%-${WIDTH}s %s\n" "$R_LABEL" "${YELLOW}未检查：是 fork 但没有 upstream 远端（用 --fix）${RESET}"
		return
		;;
	upstream-ref-missing)
		printf "%-${WIDTH}s %s\n" "$R_LABEL" "${YELLOW}无法确定上游分支（$R_REMOTE 未 fetch？）${RESET}"
		return
		;;
	esac

	if [ "$R_BEHIND" -gt 0 ]; then
		printf "${BOLD}%-${WIDTH}s${RESET} 落后 ${RED}%d${RESET} 提交 · 本地独有 %s · 上游最后: %s %s%s\n" \
			"$R_LABEL" "$R_BEHIND" "$R_AHEAD" "$R_LAST_DATE" "$R_LAST_SUBJECT" "$note"
		[ -n "$R_STAT" ] && printf "%-${WIDTH}s   %s\n" "" "${DIM}${R_STAT}${RESET}"
		[ -n "$R_COMMITS" ] && printf '%s\n' "$R_COMMITS" | sed 's/^/                         /'

	else
		printf "%-${WIDTH}s 已同步 · 本地独有 %s%s\n" "$R_LABEL" "$R_AHEAD" "$note"
	fi
}

emit_repo() {
	if [ "$JSON" = 1 ]; then
		emit_json
	else
		emit_human
	fi
}

check_repo() {
	local dir="$1" label="$2"
	local origin slug branch has_upstream purl remote base ahead behind last stat

	R_PATH="$dir" R_NAME="$(basename "$dir")" R_LABEL="$label"
	R_BRANCH="" R_REMOTE="" R_AHEAD=0 R_BEHIND=0 R_DIRTY=false
	R_HAS_UPSTREAM=false R_IS_FORK=null R_UPSTREAM_URL=""
	R_LAST_DATE="" R_LAST_SUBJECT="" R_STAT="" R_ERROR=""
	R_COMMITS=""

	if ! is_git_repo "$dir"; then
		R_ERROR="not-a-repository"
		emit_repo
		return
	fi

	origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || origin=""
	if [ -z "$origin" ]; then
		R_ERROR="no-origin"
		emit_repo
		return
	fi
	slug=$(repo_slug "$origin")
	branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=HEAD
	R_BRANCH="$branch"
	has_upstream=$(git -C "$dir" remote get-url upstream 2>/dev/null) || has_upstream=""

	if [ -n "$has_upstream" ]; then
		R_HAS_UPSTREAM=true
		R_UPSTREAM_URL="$has_upstream"
	fi

	# JSON 模式默认不问 gh（网络），除非 --fix 需要它
	if [ -z "$has_upstream" ] && { [ "$JSON" = 0 ] || [ "$FIX" = 1 ]; }; then
		if purl=$(parent_url_from_gh "$slug"); then
			R_IS_FORK=true
			if [ "$FIX" = 1 ]; then
				git -C "$dir" remote add upstream "$purl" 2>/dev/null && has_upstream="$purl"
				if [ -n "$has_upstream" ]; then
					R_HAS_UPSTREAM=true
					R_UPSTREAM_URL="$purl"
					[ "$JSON" = 0 ] && printf "${GREEN}+ %s: 已添加 upstream → %s${RESET}\n" "$label" "$purl"
				fi
			else
				need_fix+=("$label")
			fi
		else
			R_IS_FORK=false
		fi
	fi

	if [ -z "$has_upstream" ]; then
		if [ "$R_IS_FORK" = true ]; then
			R_ERROR="fork-without-upstream"
			emit_repo
			return
		fi
		remote=origin
	else
		remote=upstream
	fi
	R_REMOTE="$remote"

	base="$remote/$branch"
	[ "$branch" = "HEAD" ] && base="$remote/HEAD"

	if [ "$FETCH" = 1 ]; then
		fetch_remote "$dir" "$remote"
	fi

	# 远端分支不存在（分支被改名/删除）时退回远端默认分支
	if ! git -C "$dir" rev-parse --verify --quiet "$base" >/dev/null; then
		local def
		def=$(git -C "$dir" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null)
		[ -n "$def" ] && base="$def"
	fi

	if ! git -C "$dir" rev-parse --verify --quiet "$base" >/dev/null; then
		R_ERROR="upstream-ref-missing"
		emit_repo
		return
	fi

	# --left-right 输出 "<仅上游> <仅本地>"，即 behind / ahead
	read -r behind ahead < <(git -C "$dir" rev-list --left-right --count "$base...HEAD" 2>/dev/null || echo "0 0")
	R_AHEAD=$((ahead + 0))
	R_BEHIND=$((behind + 0))

	if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
		R_DIRTY=true
		dirty_count=$((dirty_count + 1))
	fi

	if [ "$R_BEHIND" -gt 0 ]; then
		behind_repos=$((behind_repos + 1))
		behind_total=$((behind_total + R_BEHIND))
		last=$(git -C "$dir" log -1 --date=short --format='%ad%x1f%s' "$base")
		R_LAST_DATE="${last%%$'\x1f'*}"
		R_LAST_SUBJECT="${last#*$'\x1f'}"
		R_STAT=$(git -C "$dir" diff --shortstat "HEAD...$base" 2>/dev/null | sed 's/^ *//')
		R_COMMITS=$(git -C "$dir" log --oneline -3 "$base" ^HEAD 2>/dev/null)
	fi

	emit_repo
}

for root in "${ROOTS[@]}"; do
	[ -d "$root" ] || continue
	if is_git_repo "$root"; then
		check_repo "$root" "$(basename "$root")"
		continue
	fi
	rootbase=$(basename "$root")
	for dir in "$root"/*/; do
		dir="${dir%/}"
		if [ "$JSON" = 1 ]; then
			is_git_repo "$dir" || continue
			check_repo "$dir" "$rootbase/$(basename "$dir")"
			continue
		fi
		[ -d "$dir/.git" ] || continue
		check_repo "$dir" "$(basename "$dir")"
	done
done

if [ "$JSON" = 1 ]; then
	if [ "$RESULT_COUNT" -eq 1 ]; then
		printf '%s\n' "${RESULTS[0]}"
	elif [ "$RESULT_COUNT" -gt 1 ]; then
		printf '['
		first=1
		for obj in "${RESULTS[@]}"; do
			[ "$first" = 1 ] || printf ','
			first=0
			printf '\n%s' "$obj"
		done
		printf '\n]\n'
	else
		printf '[]\n'
	fi
	exit 0
fi

echo
if [ "$behind_repos" -gt 0 ]; then
	echo "${YELLOW}${behind_repos} 个仓库有上游更新，共 ${behind_total} 个提交待合入${RESET}"
else
	echo "${GREEN}全部已是最新${RESET}"
fi
[ "$dirty_count" -gt 0 ] && echo "${DIM}${dirty_count} 个仓库有未提交改动${RESET}"

if [ ${#need_fix[@]} -gt 0 ]; then
	echo
	echo "${YELLOW}以下 fork 还没有 upstream 远端：${RESET}"
	printf '  %s\n' "${need_fix[@]}" | sort -u
	echo "运行 ${BOLD}${PROG} --fix${RESET} 用 gh 自动补上（只动 remote，不改代码）。"
fi

[ "$behind_repos" -gt 0 ] && exit 1
exit 0
