{
  "test_mod": {
    "body": [
      "#[test]",
      "fn ${1:name}() {",
      "    $0",
      "    todo!();",
      "}"
    ],
    "prefix": "test"
  },
  "test_cfg": {
    "body": [
      "#[cfg(test)]",
      "mod test {",
      "    use super::*;",
      "",
      "    #[test]",
      "    fn ${1:name}() {",
      "        $0",
      "        todo!();",
      "    }",
      "}"
    ],
    "prefix": "cfg"
  },
  "no_std_no_main": {
    "body": [
      "#![no_std]",
      "#![no_main]",
      "",
      "use cortex_m::asm;",
      "use cortex_m_rt::entry;",
      "",
      "#[entry]",
      "fn main() -> ! {",
      "    asm::nop(); // To not have main optimize to abort in release mode, remove when you add code",
      "",
      "    loop {",
      "        // your code goes here",
      "    }",
      "}"
    ],
    "description": "Rust no_std and no_main template for embedded systems",
    "prefix": "no_std_no_main"
  }
}
